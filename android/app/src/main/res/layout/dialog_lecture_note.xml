<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dt_tv_dialog_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Note at 00:00"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Note will be saved to your DegreeTrack course notes."
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/dt_et_note_text"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:background="#0F172A"
        android:gravity="top|start"
        android:hint="Type your lecture takeaway or bookmark..."
        android:inputType="textMultiLine|textCapSentences"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dt_btn_dialog_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Cancel"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/dt_btn_dialog_save"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#2563EB"
            android:text="Save Note"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
