<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dt_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Media3 Player Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/dt_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- Buffering Spinner -->
    <ProgressBar
        android:id="@+id/dt_buffering_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#3B82F6"
        android:visibility="gone" />

    <!-- Full Interactive Controls Overlay -->
    <FrameLayout
        android:id="@+id/dt_controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/dt_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dt_top_gradient"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/dt_btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dt_back"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dt_tv_course_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COURSE"
                        android:textColor="#60A5FA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  •  "
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/dt_tv_badge_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline Ready"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_dt_pill_offline" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dt_tv_lecture_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lecture Title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Bookmark / Add Note Button -->
            <LinearLayout
                android:id="@+id/dt_btn_add_note"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_dt_speed_chip"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_dt_note"
                    app:tint="#60A5FA" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="+ Note"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Center Controls: 10s Rewind, Play/Pause, 10s Fast-Forward -->
        <LinearLayout
            android:id="@+id/dt_center_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dt_btn_rewind"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_dt_center_btn"
                android:src="@drawable/ic_dt_replay_10"
                android:contentDescription="Rewind 10 seconds" />

            <ImageButton
                android:id="@+id/dt_btn_play_pause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp"
                android:background="@drawable/bg_dt_center_btn"
                android:src="@drawable/ic_dt_play"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/dt_btn_forward"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_dt_center_btn"
                android:src="@drawable/ic_dt_forward_10"
                android:contentDescription="Forward 10 seconds" />

        </LinearLayout>

        <!-- Resume Prompt Banner (Floats right above bottom bar) -->
        <LinearLayout
            android:id="@+id/dt_resume_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="110dp"
            android:background="@drawable/bg_dt_resume_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/dt_tv_resume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resumed from 12:34"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/dt_btn_restart"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Start Over"
                android:textColor="#60A5FA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/dt_btn_resume_dismiss"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dt_back"
                android:rotation="45"
                app:tint="#94A3B8"
                android:contentDescription="Dismiss" />
        </LinearLayout>

        <!-- Bottom Controls Bar -->
        <LinearLayout
            android:id="@+id/dt_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_dt_bottom_gradient"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- Scrubber & Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dt_tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <SeekBar
                    android:id="@+id/dt_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:max="1000"
                    android:progressTint="#3B82F6"
                    android:thumbTint="#60A5FA" />

                <TextView
                    android:id="@+id/dt_tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- Speed Chips & Next Lecture Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp" />

                <!-- Horizontal scroll for speed chips: 0.5x, 0.75x, 1x, 1.25x, 1.5x, 1.75x, 2x, 2.5x, 3x -->
                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/dt_speed_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <!-- Populated programmatically with chips -->
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Next Lecture Button (Shown if next lecture exists) -->
                <LinearLayout
                    android:id="@+id/dt_btn_next_lecture"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_dt_speed_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/dt_tv_next_lecture_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="140dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="Next Lecture"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_dt_next"
                        app:tint="#60A5FA" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
